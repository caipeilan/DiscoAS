{
  "manifest_version": 2,
  "name": "DiscoAS 浏览器播放桥接",
  "version": "0.5.0",
  "description": "在 DiscoAS 专用播放页切换 YouTube / Bilibili 视频与 Apple Music 网页播放器，保留网站续播。",
  "browser_specific_settings": {
    "gecko": {
      "id": "discoas-browser@discoas.local",
      "strict_min_version": "115.0"
    }
  },
  "icons": { "32": "icons/32x32.png", "128": "icons/128x128.png" },
  "permissions": ["storage", "alarms", "https://www.youtube.com/*", "https://www.bilibili.com/*", "https://music.apple.com/*"],
  "background": { "scripts": ["background.js"], "type": "module", "persistent": true },
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*", "https://www.bilibili.com/video/*"],
    "js": ["protocol.js", "content.js"],
    "run_at": "document_idle"
  }, {
    "matches": ["https://music.apple.com/*"],
    "js": ["apple-music-firefox.js"],
    "run_at": "document_idle"
  }],
  "content_security_policy": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:*"
}
