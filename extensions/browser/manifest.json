{
  "manifest_version": 3,
  "name": "DiscoAS",
  "version": "0.5.1",
  "description": "DiscoAS的浏览器扩展",
  "minimum_chrome_version": "116",
  "icons": { "32": "icons/32x32.png", "128": "icons/128x128.png" },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://www.youtube.com/*", "https://www.bilibili.com/*", "https://music.apple.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://www.bilibili.com/video/*"],
      "js": ["protocol.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://music.apple.com/*"],
      "js": ["apple-music-main.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://music.apple.com/*"],
      "js": ["apple-music-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:*"
  }
}
